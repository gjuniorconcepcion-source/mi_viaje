  transition: opacity 0.25s, transform 0.25s;
}

.chat-box.chat-abierto {
  opacity: 1;
  pointer-events: all;
  transform: translateY(0) scale(1);
}

.chat-header {
  background: var(--cafe);
  padding: 14px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chat-header-info {
  display: flex;
  align-items: center;
  gap: 10px;
}

.chat-avatar {
  font-size: 1.5rem;
  background: var(--dorado);
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-header strong {
  display: block;
  color: var(--arena);
  font-size: 0.9rem;
}

.chat-header small {
  color: var(--dorado);
  font-size: 0.75rem;
}

.chat-cerrar {
  background: none;
  border: none;
  color: var(--arena);
  font-size: 1rem;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 4px;
  transition: background 0.2s;
}

.chat-cerrar:hover {
  background: rgba(255,255,255,0.1);
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-height: 300px;
}

.chat-msg {
  max-width: 85%;
  padding: 10px 14px;
  border-radius: 14px;
  font-size: 0.88rem;
  line-height: 1.5;
  word-wrap: break-word;
}

.chat-msg-user {
  background: var(--dorado);
  color: white;
  align-self: flex-end;
  border-bottom-right-radius: 4px;
}

.chat-msg-bot {
  background: var(--arena);
  color: var(--cafe);
  align-self: flex-start;
  border-bottom-left-radius: 4px;
  border: 1px solid #e0d5c5;
}

.chat-msg.typing {
  opacity: 0.6;
  font-style: italic;
}

.chat-input-area {
  display: flex;
  border-top: 1px solid #e0d5c5;
  background: white;
}

.chat-input-area input {
  flex: 1;
  padding: 12px 16px;
  border: none;
  outline: none;
  font-family: 'Lato', sans-serif;
  font-size: 0.9rem;
  background: transparent;
  color: var(--cafe);
}

.chat-input-area input::placeholder {
  color: #aaa;
}

.chat-input-area button {
  padding: 12px 16px;
  background: var(--dorado);
  color: white;
  border: none;
  cursor: pointer;
  font-size: 1rem;
  transition: background 0.2s;
}

.chat-input-area button:hover:not(:disabled) {
  background: var(--terracota);
}

.chat-input-area button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

@media (max-width: 480px) {
  .chat-box {
    width: calc(100vw - 32px);
    right: 16px;
    bottom: 80px;
  }
  .chat-toggle {
    right: 16px;
    bottom: 16px;
  }
}
